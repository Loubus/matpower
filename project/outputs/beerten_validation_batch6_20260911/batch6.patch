+function [base,target,options,study] = beerten_constant_pq_capability_batch6
+%BEERTEN_CONSTANT_PQ_CAPABILITY_BATCH6 Saved direction with supported limits.
+% Project scenario, not the published Beerten PF configuration. The slack is
+% exempt in the implementation. Applying the generic MBASE-based curve to it
+% makes the initial point infeasible. See the batch-6 REPORT before using a
+% configured stop as a physical or published stability margin.
+root=fileparts(fileparts(fileparts(mfilename('fullpath'))));
+fixture=fullfile(root,'outputs','algorithm_cleanup_batch4_20260911','beerten_probe.mat');
+s=load(fixture,'b4f','b4t','b4o');base=s.b4f;target=s.b4t;
+options=mpoption(s.b4o,'cpf.stop_at','NOSE','exp.psse_pqbrak',0, ...
+ 'vsc_mtdc.psse_control_limit','saturate','vsc_mtdc.capability_enforce',1, ...
+ 'vsc_mtdc.capability_gen_enforce',1,'cpf.enforce_q_lims',1);
+study=struct('name','beerten_constant_pq_supported_capabilities', ...
+ 'fixture',fixture,'P5_MW','60 + 240*lambda','Q5_MVAr','10 + 40*lambda', ...
+ 'total_P_MW','165 + 240*lambda','total_Q_MVAr','40 + 40*lambda', ...
+ 'gen_dispatch','P2=40 MW; slack supplies remainder and losses', ...
+ 'q_box_option_scope','requested, but no RAW GENQ metadata in this unified fixture', ...
+ 'stability_margin_validated',false);
+end

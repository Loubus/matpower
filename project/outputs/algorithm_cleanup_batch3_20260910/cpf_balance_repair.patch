+    function value = unified_residual_norm(F, model)
+        % Retain every scalar equation (including CPF parameterization), and
+        % also require the complex nodal power mismatch to meet the same tol.
+        % Separate P/Q components can each pass while hypot(P,Q) exceeds tol.
+        np = length(model.nonref);
+        nq = length(model.qeq);
+        ac_mismatch = complex(zeros(model.nb, 1));
+        ac_mismatch(model.nonref) = F(1:np);
+        ac_mismatch(model.qeq) = ac_mismatch(model.qeq) + ...
+            1j * F(np + (1:nq));
+        % A single norm preserves NaN propagation from any scalar equation.
+        value = norm([F; ac_mismatch], Inf);
+    end

+    function [s,u,r] = both(f,v)
+        dm=struct('source',f,'elements',struct('bus',struct('tab',struct('vm',v))));
+        task=struct('dmc',[],'data_model_build',@(mpc,varargin) mpc);
+        [~,s]=mp.psse_xfmr_control(task,[],[],dm,opt,{},[]);

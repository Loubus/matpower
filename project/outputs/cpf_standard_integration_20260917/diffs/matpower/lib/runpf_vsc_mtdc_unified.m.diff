+        U=eval.Vm(model.map.internal(k)); Ilim=mpc.vsc_current_limit(k);
+        J(row,:)=2*(eval.pac(k)*dPac(k,:)+eval.qac(k)*dQac(k,:))/(baseMVA*U*Ilim)^2 ...

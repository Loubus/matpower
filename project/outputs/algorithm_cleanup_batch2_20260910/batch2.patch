+[~, k] = ismember(f.vsc(:, c.VSC_BUS), ids); f.vsc(:, c.VSC_BUS) = ext(k);
+f.gen = f.gen([2 1 2], :); f.gen(3, ON) = 0;
+f.gencost = repmat([2 0 0 2 1 0], 3, 1);

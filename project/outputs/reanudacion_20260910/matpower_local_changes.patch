+    idx = bus_lookup(mpc.order.bus.i2e(:), bus);
+elseif isfield(mpc, 'order') && isfield(mpc.order, 'bus') && ...
+        isfield(mpc.order.bus, 'e2i') && ~isempty(mpc.order.bus.e2i)
+    e2i = mpc.order.bus.e2i;
+    if bus <= size(e2i, 1)
+        idx = full(e2i(bus));
+    end
+else

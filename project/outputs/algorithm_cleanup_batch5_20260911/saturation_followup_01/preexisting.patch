+t_ok(exist(tmp_mat_name, 'file'), [t 'MAT-file exists']);
+s = load(tmp_mat_name);
+t_is(s.chgtab, chgtab, 12, [t 'table from MAT-file matches']);
+delete(tmp_mat_name);
+t_ok(~exist(tmp_mat_name, 'file'), [t 'MAT-file successfully deleted']);
+
+t_end;

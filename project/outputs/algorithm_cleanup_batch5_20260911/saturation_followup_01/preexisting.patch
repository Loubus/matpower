+options.ipopt.jac_d_constant    = 'yes';
+options.ipopt.hessian_constant  = 'yes';
+options.ipopt.least_square_init_primal  = 'yes';
+options.ipopt.least_square_init_duals   = 'yes';
+% options.ipopt.mehrotra_algorithm        = 'yes';        %% default 'no'
+if verbose

+t_str_match(om.soln.output.alg, out.alg, [t 'output.alg']);
+t_is(om.soln.jac, jac, 14, [t 'jac']);
+
+t = 'om.get_soln(''var'', ''x'') : ';
+t_is(om.get_soln('var', 'x'), x, 14, [t 'x']);
+
+t = 'om.get_soln(''lin'', ''A12'') : ';

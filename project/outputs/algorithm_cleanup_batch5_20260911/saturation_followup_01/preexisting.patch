+    1e-6    40  1e-6    40;
+    1e-6    60  1e-6    60;
+    1e-6    Inf 1e-6    Inf;
+];
+load_profile = struct( ...
+    'type', 'mpcData', ...
+    'table', CT_TLOAD, ...
+    'rows', 0, ...
+    'col', CT_LOAD_ALL_PQ, ...
+    'chgtype', CT_REP, ...
+    'values', [] );
+load_profile.values(:, 1, 1) = [
+    199.9;
+    219.1;
+];% -1e-3;
+lp = {load_profile, load_profile};
+lp{2}.values(:, 1, 1) = [219.1; 118.8999];
+%% StorageData
+iess = 3;
+mpc.iess = iess;
+sv = 0;     %% cost/value of initial/residual stored energy
+sd_table.OutEff     = 1;
+sd_table.InEff      = 1;
+sd_table.LossFactor = 0;

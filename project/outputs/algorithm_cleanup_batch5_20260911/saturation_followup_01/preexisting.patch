+task = run_opf(mpc, mpopt, 'mpx', mp.xt_legacy_dcline);
+r = task.dmc.export(task.dm, task.dm.source);
+t_ok(task.success, [t 'success']);
+expected = [
+	10	8.9	0	0	1.01	1;

+%   Example:
+%       mpc = om.get_mpc();
+%       om = run_userfcn(mpc.userfcn, 'formulation', om);
+%
+% See also add_userfcn, remove_userfcn, toggle_reserves, toggle_iflims,
+% runopf_w_res.
+
+%   MATPOWER

+	17	17	17.975886006576545;
+];
+A3 = sparse(ijs3(:, 1), ijs3(:, 2), ijs3(:, 3));
+b3 = [
+	1.63;
+	0.85;
+	0.6;
+	1.63;
+	0.85;
+	0;
+	-0.9;
+	0;
+	-1;
+	0;

+    x_ = [v_; z_];
+    SS = ac.port_inj_power(x_);
+    num_Szib = (SS - SS0) / dx;
+    t_is(full(Szi), num_Szib, 6, [t 'Szi']);
+
+    t = sprintf('%s : ac.port_inj_power(x_, 1, idx) : ', tc(c).name);

+    t_ok(isequal(T{:, 3}, v3), [t 'T{:, 3} == v3']);
+    t_ok(isequal(T{:, 4}, v4), [t 'T{:, 4} == v4']);
+    t_ok(isequal(T{:, 5}, v5), [t 'T{:, 5} == v5']);
+    t_ok(isequal(T{:, 6}, v6), [t 'T{:, 6} == v6']);
+
+    t_ok(isequal(T{:, 4:6}, [v4 v5 v6]), [t 'T{:, j1:jN}']);
+    t_ok(isequal(T{:, 2:2:6}, [v2 v4 v6]), [t 'T{:, j1:2:jN}']);

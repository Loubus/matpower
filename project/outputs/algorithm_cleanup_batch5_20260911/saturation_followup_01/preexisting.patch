+    mpc.u = [0; 0];
+    mpc.l = [-Inf; -Inf];
+    mpc.zl = [0; 0];
+
+    mpc.N = sparse([1;2], [25;26], [1;1], 2, 26);   %% new z variables only
+    mpc.fparm = ones(2,1) * [1 0 0 1];              %% w = r = z
+    mpc.H = sparse(2,2);                            %% no quadratic term
+    mpc.Cw = [1000;1];

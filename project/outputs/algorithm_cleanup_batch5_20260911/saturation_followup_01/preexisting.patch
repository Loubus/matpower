+    'runcpf_psse sequential VSC-MTDC CPF uses runpf_psse AC subproblem');
+t_str_match(rpsse_seq.psse.cpf.task_class, 'sequential_vsc_mtdc', ...
+    'runcpf_psse reports sequential VSC-MTDC task class when requested');
+t_ok(~isempty(strfind(rpsse_seq.psse.cpf.formulation, 'Sequential VSC-MTDC')), ...
+    'runcpf_psse reports sequential formulation when requested');
+
+%%-----  droop variant  -----
+mpcd = mpc3;
+mpcd.vsc(3, c.DC_MODE) = c.VSC_DC_DROOP;
+mpcd.vsc(3, c.KDROOP) = -150;
+[rd, success] = runpf_vsc_mtdc(mpcd, mpopt_seq);
+t_ok(success, 'droop variant PF success');
+t_is(rd.vsc(3, c.PDC), ...
+    mpcd.vsc(3, c.PDC_SET) + mpcd.vsc(3, c.KDROOP) * (rd.vsc(3, c.VDC) - mpcd.vsc(3, c.VDC_SET)), ...
+    8, 'droop sign convention');
+t_ok(abs(rd.vsc(3, c.PDC) - mpcd.vsc(3, c.PDC_SET)) > 1e-3, ...
+    'droop is optional and changes Pdc');
+t_ok(rd.vsc(1, c.IS_DC_SLACK) == 1 && mpcd.vsc(1, c.DC_MODE) == c.VSC_DC_VDC, ...
+    'Vdc slack remains default DC reference');
+[rdu, success] = runpf_vsc_mtdc(mpcd, mpopt_u);
+t_ok(success, 'droop variant unified PF success');
+t_is(rdu.vsc(active3, [c.PAC c.QAC c.PDC c.VDC c.VAC_PCC c.VAC_INTERNAL c.PLOSS]), ...
+    rd.vsc(active3, [c.PAC c.QAC c.PDC c.VDC c.VAC_PCC c.VAC_INTERNAL c.PLOSS]), ...
+    6, 'droop variant unified VSC results match sequential solution');
+
+%%-----  unified analytic Jacobian validation  -----
+jacb = vsc_unified_jacobian_check(mpcb, mpopt_u);
+t_ok(jacb.max_abs < 2e-6 && jacb.max_rel < 1e-6, ...
+    'Beerten unified PF analytic Jacobian matches finite differences');
+t_ok(jacb.ac_cols_abs < 2e-6, ...
+    'Beerten unified PF Jacobian AC angle and voltage columns validate');
+t_ok(jacb.pac_cols_abs < 1e-8, ...
+    'Beerten unified PF Jacobian Pac columns validate');
+t_ok(jacb.vdc_cols_abs < 1e-7, ...
+    'Beerten unified PF Jacobian Vdc columns validate');
+t_ok(jacb.vsc_dc_rows_abs < 2e-6, ...
+    'Beerten unified PF Jacobian VSC/DC equation rows validate');
+
+jacd = vsc_unified_jacobian_check(mpcd, mpopt_u);
+t_ok(jacd.max_abs < 2e-6 && jacd.max_rel < 1e-6, ...
+    'droop unified PF analytic Jacobian matches finite differences');
+t_ok(jacd.ac_cols_abs < 2e-6, ...
+    'droop unified PF Jacobian AC angle and voltage columns validate');
+t_ok(jacd.pac_cols_abs < 1e-8, ...
+    'droop unified PF Jacobian Pac columns validate');
+t_ok(jacd.vdc_cols_abs < 1e-7, ...
+    'droop unified PF Jacobian Vdc columns validate');
+t_ok(jacd.vsc_dc_rows_abs < 2e-6, ...
+    'droop unified PF Jacobian VSC/DC equation rows validate');
+
+cpf_jac = vsc_unified_cpf_jacobian_check(mpcb, mpct, mpopt_cpf);
+t_ok(cpf_jac.block_j_abs < 2e-6, ...
+    'unified CPF augmented Jacobian embeds validated PF Jacobian block');
+t_ok(cpf_jac.dlam_abs < 1e-8, ...
+    'unified CPF dF/dlambda column matches finite differences');
+t_ok(cpf_jac.param_abs < 1e-8, ...
+    'unified CPF parametrization row matches finite differences');
+t_ok(cpf_jac.aug_abs < 2e-6, ...
+    'unified CPF augmented analytic Jacobian matches finite differences');
+
+%%-----  convergence and excluded data/model columns  -----
+t_ok(r3.convergence.max_balance < r3.convergence.tol_p, 'converged VSC balance residual');
+t_ok(r3.convergence.max_delta_vdc < r3.convergence.tol_v, 'converged DC voltage change');
+t_ok(r3.convergence.max_vac_ctrl_error < r3.convergence.tol_v, ...
+    'converged VSC PCC voltage control error');
+t_ok(~isfield(r3, 'converter') && ~isfield(r3, 'hvdc') && ~isfield(r3, 'converter_type'), ...
+    'no generic converter or HVDC result fields');
+idx_txt = fileread(which('idx_vsc'));
+t_ok(~isfield(c, ['TR_' 'TAP']) && isempty(strfind(idx_txt, ['tr_' 'tap'])) && ...
+     isempty(strfind(idx_txt, 'PMIN')) && isempty(strfind(idx_txt, 'PMAX')) && ...
+     isempty(strfind(idx_txt, 'QMIN')) && isempty(strfind(idx_txt, 'QMAX')) && ...
+     isempty(strfind(idx_txt, 'VDC_MIN')) && isempty(strfind(idx_txt, 'VDC_MAX')) && ...
+     isempty(strfind(idx_txt, 'IMAX')) && isempty(strfind(idx_txt, 'SMAX')), ...
+     'idx_vsc excludes taps and operational limit columns');
+
+t_end;

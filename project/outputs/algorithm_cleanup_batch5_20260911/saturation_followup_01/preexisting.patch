+    t_is([min(r.bus(:, VM)) mean(r.bus(:, VM)) max(r.bus(:, VM))], ...
+        [1.070692 1.090449 1.1], 5, [t 'bus voltage']);
+else
+    t_skip(num_tests, [t0 'not available']);

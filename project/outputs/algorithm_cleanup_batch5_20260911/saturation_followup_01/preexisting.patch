+function [g, dg] = my_fcn(x, p1, p2)
+if iscell(x)
+    xx = [];
+    for k = 1:length(x)
+        xx = [xx; x{k}];
+    end
+else
+    xx = x;
+end
+M = p1;
+N = length(xx);
+if M > N
+    error('M <= length(x)');
+end
+g = xx(1:M) + p2;
+dg = sparse(1:M, 1:M, p2, M, N) + sparse(1, 1:N, xx, M, N);
+
+function d2G = my_hess(x, lam, p3)
+if iscell(x)
+    xx = [];
+    for k = 1:length(x)
+        xx = [xx; x{k}];
+    end
+else
+    xx = x;
+end
+N = length(xx);
+M = length(lam);
+MM = min(M, N);
+d2G = sparse(1:MM, 1:MM, xx(1:MM) + lam(1:MM) + p3, N, N);
+%full(d2G(1:MM,1:MM))

+    
+    mpc0.bus_name       = [mpc0.bus_name;       mpc{k}.bus_name];
+    mpc0.gentype        = [mpc0.gentype;        mpc{k}.gentype];
+    mpc0.genfuel        = [mpc0.genfuel;        mpc{k}.genfuel];
+    mpc0.bus_label      = [mpc0.bus_label;      mpc{k}.bus_label];

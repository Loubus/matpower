+    mpc{k}.bus(:, BUS_I)    = mpc{k}.bus(:, BUS_I)  + offset;
+    mpc{k}.gen(:, GEN_BUS)  = mpc{k}.gen(:, GEN_BUS)    + offset;
+    mpc{k}.branch(:, F_BUS) = mpc{k}.branch(:, F_BUS)   + offset;

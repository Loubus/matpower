+        1e-4;   %% 17 - CONSTR_TOL_X
+        1e-4;   %% 18 - CONSTR_TOL_F
+        0;      %% 19 - CONSTR_MAX_IT
+        3e-3;   %% 20 - LPC_TOL_GRAD (removed)
+        1e-4;   %% 21 - LPC_TOL_X (removed)
+        400;    %% 22 - LPC_MAX_IT (removed)
+        5;      %% 23 - LPC_MAX_RESTART (removed)
+        0;      %% 24 - OPF_FLOW_LIM

+funcs.objective         = @(x) 0.5 * x' * H * x + c' * x;
+funcs.gradient          = @(x) H * x + c;
+funcs.constraints       = @(x) A * x;
+funcs.jacobian          = @(x) A;
+funcs.jacobianstructure = @() A;
+funcs.hessian           = @(x, sigma, lambda) tril(H);
+funcs.hessianstructure  = @() tril(H);
+

+            %
+
+            %% get model variables
+            vvars = nm.model_vvars();
+
+            %% voltage real part
+            obj.add_system_varset_pf(nm, vvars{1}, 'pq');
+            obj.add_system_varset_pf(nm, vvars{1}, 'pv');
+
+            %% voltage imaginary part

+x = soln.col_value;
+f = info.objective_function_value;
+eflag = info.valid && soln.value_valid;
+output = info;
+
+%% separate duals into binding lower & upper bounds
+if nA == 0      %% unconstrained
+    mu_l = [];
+    mu_u = [];
+elseif soln.dual_valid
+    mu_l =  soln.row_dual;
+    mu_u = -soln.row_dual;
+    mu_l(mu_l < 0) = 0;
+    mu_u(mu_u < 0) = 0;
+else
+    mu_l = NaN(nA, 1);
+    mu_u = NaN(nA, 1);
+end
+
+%% variable bounds
+if soln.dual_valid
+    lam_lower =  soln.col_dual;
+    lam_upper = -soln.col_dual;
+    lam_lower(lam_lower < 0) = 0;
+    lam_upper(lam_upper < 0) = 0;
+else
+    lam_lower = NaN(nx, 1);
+    lam_upper = NaN(nx, 1);
+end
+
+%% package lambdas
+lambda = struct( ...
+    'mu_l', mu_l, ...
+    'mu_u', mu_u, ...
+    'lower', lam_lower, ...
+    'upper', lam_upper ...
+);

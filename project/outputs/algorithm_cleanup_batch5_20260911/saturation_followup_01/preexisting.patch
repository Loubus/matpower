+    end
+    if normF < tol
+        converged = 1;
+        if mpopt.verbose
+            fprintf('\nNewton''s method power flow (current balance, cartesian) converged in %d iterations.\n', i);
+        end
+    end
+end
+
+if mpopt.verbose
+    if ~converged
+        fprintf('\nNewton''s method power flow (current balance, cartesian) did not converge in %d iterations.\n', i);
+    end
+end

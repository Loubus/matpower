+  % 7   opf(baseMVA, bus, gen, branch, areas, gencost, mpopt)
+  % 6   opf(baseMVA, bus, gen, branch, areas, gencost)
+  if any(nargin == [6, 7, 8, 9, 10, 14, 17])
+    if nargin == 14
+      zu    = [];
+      zl    = [];
+      z0    = [];
+    elseif nargin == 10
+      zu    = [];
+      zl    = [];
+      z0    = [];
+      Cw    = [];
+      H     = sparse(0,0);
+      fparm = [];
+      N     = sparse(0,0);
+    elseif nargin == 9
+      zu    = [];

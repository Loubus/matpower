+        0;      %% 52 - RETURN_RAW_DER
+        0;      %% 53 - RESERVED53
+        0;      %% 54 - RESERVED54
+        4;      %% 55 - FMC_ALG
+        0;      %% 56 - RESERVED56
+        0;      %% 57 - RESERVED57
+        0;      %% 58 - KNITRO_OPT
+        0;      %% 59 - RESERVED59
+        0;      %% 60 - IPOPT_OPT
+        
+        %% MINOPF options
+        0;      %% 61 - MNS_FEASTOL
+        0;      %% 62 - MNS_ROWTOL
+        0;      %% 63 - MNS_XTOL
+        0;      %% 64 - MNS_MAJDAMP
+        0;      %% 65 - MNS_MINDAMP

+        ek = e0; ek(k) = 1;
+        HH = HH + lam(k) * ac.port_inj_current_hess(x0, ek, 0);
+    end
+    t_is(H, HH, 12, [t 'weighted sum indiv Hessians']);
+
+    t = sprintf('%s : ac.port_inj_current_hess(x_, lam, 0, idx) : ', tc(c).name);
+    H = ac.port_inj_current_hess(x0, lam(idx), 0, idx);

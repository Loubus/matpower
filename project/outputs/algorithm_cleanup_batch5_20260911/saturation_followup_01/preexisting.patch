+    sv2 = sv2 + (0.06*rand(size(sv1)) - 0.03);  sv2(ref) = 1;
+
+    %% adjust values of z_
+    szr(1) = 0.67;
+    szi(1:3) = [0.1; 0.2; 0.3];
+
+    %% initialize v_, z_, x_
+    sv = sv2 .* exp(1j * sv1);
+    sz = szr + 1j * szi;
+    sx = [sv; sz];
+    nx = length(sx);
+    t_is(nx, nv+nz, 12, t);
+
+    %%-----  tests using system voltages  -----
+    t = sprintf('%s : ac.port_inj_current(x_) : ', tc(c).name);
+    v10 = sv1; v20 = sv2; zr0 = szr; zi0 = szi; %% init w/ system v_, z_ components
+    v0 = v20 .* exp(1j * v10);
+    z0 = zr0 + 1j * zi0;

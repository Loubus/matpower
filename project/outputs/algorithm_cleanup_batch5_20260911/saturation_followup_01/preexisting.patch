+t_is(mpc1.areas,    areas,      12, [t 'areas']);
+t_is(mpc1.gencost,  gencost,    12, [t 'gencost']);
+
+t = 'mpc = loadcase(opf_MAT_file_v1) without .mat extension : ';
+mpc1 = loadcase(matfile);
+t_is(mpc1.baseMVA,  baseMVA,    12, [t 'baseMVA']);

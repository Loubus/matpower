+    t_is(r.gen(3, PG), 116.15974, 5, [t 'Pg3 = 116.15974']);
+    t_is(r.var.val.z, [0; 0.3348], 4, [t 'user vars']);
+    t_is(r.cost.usr, 0.3348, 4, [t 'user costs']);

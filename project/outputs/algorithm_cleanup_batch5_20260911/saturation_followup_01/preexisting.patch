+
+TorF = exist('pardisoinit', 'file') == 3 && ...
+        exist('pardisoreorder', 'file') == 3 && ...
+        exist('pardisofactor', 'file') == 3 && ...
+        exist('pardisosolve', 'file') == 3 && ...
+        exist('pardisofree', 'file') == 3;
+rdate = '';
+if TorF
+    vstr = '6.x+';

+        profiles = getprofiles(profiles, s_profile);
+    end
+    nt = size(profiles(1).values, 1);       % number of periods
+    mdi = loadmd(mpc, nt, xgd, sd, [], profiles);
+    if w > 1
+        mdi.InitialPg = ms.Pg(:, 1);
+        mdi.Storage.InitialStorage = ms.SoC(:, 1);

+
+    t = 'one marginal offer @ $50, auction_type = 3';
+    [MVAbase, cq, cp, bus, gen, gencost, branch, f, dispatch, success, et] = ...
+        runmkt('t_auction_case', q, p, 1130, 100, [], [], mpopt);

+eLMP = {[16.3 16.3; 16.3 16.3; 16.3 16.3], [19 13.6; 19 13.6; 19 13.6]};
+eTLMP = {[16.3 16.3; 16.3 16.3; 16.3 16.3], [16.3 16.3; 19 13.6; 19 13.6]};
+eTLMPs = {[15.7 15.7], [15.7 13.6]};

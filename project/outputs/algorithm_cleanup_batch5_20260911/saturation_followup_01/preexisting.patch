+      N     = sparse(0,0);
+      mpopt = mpoption;
+    elseif nargin == 8
+      userfcn = Au;
+      zu    = [];
+      zl    = [];
+      z0    = [];
+      Cw    = [];
+      H     = sparse(0,0);
+      fparm = [];
+      N     = sparse(0,0);
+      mpopt = lbu;

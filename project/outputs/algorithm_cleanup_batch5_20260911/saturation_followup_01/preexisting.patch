+
+    %% construct initial system v1, v2, zr, zi, v_, z_, x_
+    t = sprintf('%s : construct initial system v_, z_', tc(c).name);
+    sv1 = ac.params_var('va');
+    sv2 = ac.params_var('vm');
+    szr = ac.params_var('zr');

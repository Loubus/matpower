+    %%-----  tests using system voltages  -----
+    t = sprintf('%s : ac.port_inj_power(x_) : ', tc(c).name);
+    v10 = sv1; v20 = sv2; zr0 = szr; zi0 = szi; %% init w/ system v_, z_ components
+    v0 = v10 + 1j * v20;

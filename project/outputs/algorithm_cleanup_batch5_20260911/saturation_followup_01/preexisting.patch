+mu_u = zeros(nA, 1);
+mu_u(ku) = lam(ku);
+
+lambda = struct( ...
+    'mu_l', mu_l, ...
+    'mu_u', mu_u, ...
+    'lower', zl, ...
+    'upper', zu    );

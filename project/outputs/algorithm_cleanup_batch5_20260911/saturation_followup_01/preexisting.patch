+    dx = 1e-8;
+    idx = randperm(np, fix(0.67*np))';
+    lam = (1.5*rand(np, 1) + 0.5); k = randperm(np, fix(np/2)); lam(k) = -lam(k);
+    e0 = zeros(np, 1);
+    e1 = ones(np, 1);
+
+    %% get ref bus index

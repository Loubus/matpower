+    1e-6    Inf 1e-6    Inf;
+];
+load_profile = struct( ...
+    'type', 'mpcData', ...
+    'table', CT_TLOAD, ...
+    'rows', 0, ...
+    'col', CT_LOAD_ALL_PQ, ...
+    'chgtype', CT_REP, ...
+    'values', [] );
+load_profile.values(:, 1, 1) = [
+    420;
+    590;
+    590;
+]-1e-3;

+    ig_disp     = [PG QG VG];
+    ig_mu       = (MU_PMAX:MU_QMIN);
+    ibr_data    = (1:ANGMAX);
+    ibr_flow    = (PF:QT);
+    ibr_mu      = [MU_SF MU_ST];
+    ibr_angmu   = [MU_ANGMIN MU_ANGMAX];
+
+    %% get solved DC power flow case from MAT-file

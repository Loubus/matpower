+    names = struct( ...
+        'choose', 'default', ...
+        'simplex', 'dual simplex', ...
+        'ipm', 'interior point (auto)', ...
+        'ipx', 'interior point (IPX)', ...
+        'hipo', 'interior point (HiPO)', ...
+        'pdlp', 'primal-dual hybrid gradient' );
+    if ismember(solver, fieldnames(names))

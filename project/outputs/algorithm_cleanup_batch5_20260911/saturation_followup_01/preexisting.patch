+Vmax = 1 + 0.01*(1:5)';
+vt = 'I';
+om.add_var('Vm1', 5, V0, Vmin, Vmax, vt);
+vNS = vNS + 1; vN = vN + 5;
+t_ok(om.getN('var') == vN, sprintf('%s : var.N  = %d', t, vN));
+t_ok(om.get('var', 'NS') == vNS, sprintf('%s : var.NS = %d', t, vNS));

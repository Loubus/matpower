+    t_is(mdo.results.GenPrices, eLMP{w}, 5, sprintf('%s window %d : %s', t, w, 'LMP'));
+    t_is(mdo.results.GenTLMP, eTLMP{w}, 5, sprintf('%s window %d : %s', t, w, 'TLMP'));
+
+    if verbose
+        fprintf('    ');
+        for t = 1:nt
+            fprintf('%-20s', sprintf('   T=%d', t));
+        end
+        fprintf('\n');
+        for g = 1:2
+            fprintf('G%d  ', g);
+            for t = 1:nt
+                fprintf('%-20s', ...
+                    sprintf('(%.4g, %.4g, %.4g)', ms.Pg(g, t), ...

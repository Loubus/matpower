+    pl = cell2mat(cellfun(@(x)opf.dm.elements.line3p.tab.(x), pl_fields, 'UniformOutput', 0));
+    t_is(va, [eva; eva+3.656255521718970; eva+1.039772166853819], 7, [t 'va']);
+    t_is(vm, [evm; evm; evm], 7, [t 'vm']);
+    t_is(pl, [epl; epl; epl], 5, [t 'pl']);

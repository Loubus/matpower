+%   See https://github.com/MATPOWER/mp-opt-model for more info.
+
+if nargin < 1
+    quiet = 0;
+end
+
+algs = {'DEFAULT', 'CPLEX', 'MOSEK', 'GUROBI', 'HIGHS', 'GLPK', 'OT'};
+names = {'DEFAULT', 'CPLEX', 'MOSEK', 'Gurobi', 'HiGHS', 'glpk', 'intlin/lin/quadprog'};

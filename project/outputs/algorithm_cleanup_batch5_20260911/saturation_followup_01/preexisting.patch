+
+for c = 1:length(tc)
+    %% create network model object
+    mpc = loadcase(casefile);
+    dm = mp.data_model().modify_element_classes(@mp.dme_gizmo).build(mpc, dmc);
+    ac = mp.net_model_acp().modify_element_classes(@mp.nme_gizmo_acp).build(dm);

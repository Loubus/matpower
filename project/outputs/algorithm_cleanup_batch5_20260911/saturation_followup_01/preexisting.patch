+%         2   2000    0   3   1/2     0   0   0   0   0;
+%         2   0       0   6   1e-6/5  0   0   0   0   0;
+%         2   0       0   3   1/2     0   0   0   0   0;
+%         2   0       0   5   1e-4/4  0   0   0   0   0;

+    error('opf_args.m: Incorrect input parameter order, number or type');
+  end
+  mpc = loadcase(casefile);
+  [baseMVA, bus, gen, branch, gencost] = ...
+    deal(mpc.baseMVA, mpc.bus, mpc.gen, mpc.branch, mpc.gencost);
+  if isfield(mpc, 'areas')
+    areas = mpc.areas;
+  else
+    areas = [];

+    t = 'one marginal offer @ $50, auction_type = 8';
+    [MVAbase, cq, cp, bus, gen, gencost, branch, f, dispatch, success, et] = ...
+        runmkt('t_auction_case', q, p, 1180, 100, [], [], mpopt);

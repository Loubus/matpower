+
+    %%-----  tests using port voltages  -----
+    t = sprintf('%s : ac.port_inj_current(x_, 0) : ', tc(c).name);
+    v10 = C'*sv1; v20 = C'*sv2; zr0 = D'*szr; zi0 = D'*szi; %% init w/ port v_, z_ components

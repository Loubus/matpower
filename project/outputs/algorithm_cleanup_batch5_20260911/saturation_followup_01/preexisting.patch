+else
+    eflag = 0;
+end
+output = struct('status', info.status);
+if isfield(info, 'iter')
+    output.iterations = info.iter;
+else
+    output.iterations = [];
+end
+if isfield(info, 'cpu')
+    output.cpu = info.cpu;
+end
+if isfield(info, 'eval')
+    output.eval = info.eval;
+end

+
+%%-----  TLMP Example 2  -----
+t = 'example 2';
+if verbose > 1
+    fprintf('\n--------------------  TLMP Example 2  --------------------\n');
+end
+load_profile = struct( ...
+    'type', 'mpcData', ...

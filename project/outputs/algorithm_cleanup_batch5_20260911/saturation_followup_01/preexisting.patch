+            %
+        end
+
+        function obj = data_model_update_on(obj, mm, nm, dm, mpopt)
+            %
+
+            dme = obj.data_model_element(dm);
+            nme = obj.network_model_element(nm);
+
+            ss = nm.get_idx('state');
+
+            for p = 1:nme.nz
+                %% buslink complex power flows
+                zbl = nm.soln.z(ss.i1.buslink(p):ss.iN.buslink(p));

+task = run_pf(mpc1, mpopt);
+rp = task.dmc.export(task.dm, task.dm.source);
+t_ok(task.success, [t 'success']);
+t_is(   rp.bus(:,ib_voltage),    r.bus(:,ib_voltage),  3, [t 'bus voltage']);
+t_is(   rp.gen(:,ig_disp   ),    r.gen(:,ig_disp   ),  3, [t 'gen dispatch']);

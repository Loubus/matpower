diff --git a/docs/sphinx/source/matlab-source/matpower/+mp/net_model.m b/docs/sphinx/source/matlab-source/matpower/+mp/net_model.m
index 9e93dd98..c9b3b480 120000
--- a/docs/sphinx/source/matlab-source/matpower/+mp/net_model.m
+++ b/docs/sphinx/source/matlab-source/matpower/+mp/net_model.m
@@ -1 +1,1257 @@
-../../../../../../lib/+mp/net_model.m

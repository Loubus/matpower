+                        x(3)*x(4)     0     x(1)*x(4) x(1)*x(3);
+                        x(2)*x(4) x(1)*x(4)     0     x(1)*x(2);
+                        x(2)*x(3) x(1)*x(3) x(1)*x(2)     0  ]);

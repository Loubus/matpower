+                'NegativeLoadFollowReservePrice', ...
+                        'NegativeLoadFollowReserveQuantity', ...
+};
+xgd_table.data = [
+    1e-6    40  1e-6    40;
+    1e-6    Inf 1e-6    Inf;
+    1e-6    Inf 1e-6    Inf;
+];
+xgd_table.data = [

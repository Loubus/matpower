+    j32 = dV2_dVr;
+    j33 = dV2_dVi;
+
+    J = [   j11 j12 j13;
+            j21 j22 j23;
+            j31 j32 j33;    ];
+
+    %% compute update step
+    dx = mplinsolve(J, -F, lin_solver);
+
+    %% update voltage
+    if npv
+        V(pv) = V(pv) + dx(j5:j6) + 1j * dx(j9:j10);
+        Sb(pv) = real(Sb(pv)) + 1j * (imag(Sb(pv)) + dx(j1:j2));
+    end
+    if npq
+        V(pq) = V(pq) + dx(j3:j4) + 1j * dx(j7:j8);
+    end
+

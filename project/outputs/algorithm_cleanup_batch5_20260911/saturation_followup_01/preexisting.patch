+mpc.psse.genq = struct( ...
+    'colnames', {{'I'}}, ...
+    'num', zeros(2, 1), ...
+    'txt', {cell(2, 1)}, ...
+    'bus_ext', [1; 2], ...
+    'reg_bus_ext', [1; 2], ...
+    'status', [1; 1], ...
+    'qg', [0; 0], ...
+    'qmax', [500; -20], ...
+    'qmin', [-500; -100], ...
+    'vs', [1.06; 1.00], ...
+    'rmpct', [100; 100] );

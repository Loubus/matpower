+    end
+    for k = 1:Nz
+        z_ = zr0 + 1j * zi0;
+        z_(k) = z_(k) + dx;
+        x_ = [v0; z_];
+        [I0p, Iv1p, Iv2p, Izrp, Izip] = ac.port_inj_current(x_, 0);
+        numH(:, 2*Nv+k) = ([Iv1p, Iv2p, Izrp, Izip]- [Iv1, Iv2, Izr, Izi]).' * lam / dx;
+
+        z_ = zr0 + 1j * zi0;
+        z_(k) = z_(k) + 1j*dx;
+        x_ = [v0; z_];
+        [I0p, Iv1p, Iv2p, Izrp, Izip] = ac.port_inj_current(x_, 0);

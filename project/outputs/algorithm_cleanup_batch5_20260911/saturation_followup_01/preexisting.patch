+        opt_r.relax_integer = 1;
+        opt_f = opt;
+        opt_f.fix_integer = 1;
+
+% opt.verbose = 3;
+        t = sprintf('%s - 2-d ILP : ', names{k});
+        %% from MOSEK 6.0 Guided Tour, section  7.13.1, https://docs.mosek.com/6.0/toolbox/node009.html
+        c = [-2; -3];
+        A = sparse([195 273; 4 40]);

+%%-----  softlims_mat2lims  --------------------------------------------
+function mat2lims = softlims_mat2lims(mpopt)
+if nargin < 1
+    mpopt = [];
+end
+if ~isempty(mpopt) && isfield(mpopt, 'model') && strcmp(mpopt.model, 'DC')
+    mat2lims = struct(...
+        'branch', {{'ANGMAX', 'ANGMIN', 'RATE_A'}}, ...
+        'gen', {{'PMAX', 'PMIN'}} ...
+    );
+else
+    mat2lims = struct(...
+        'bus', {{'VMAX', 'VMIN'}}, ...
+        'branch', {{'ANGMAX', 'ANGMIN', 'RATE_A'}}, ...
+        'gen', {{'PMAX', 'PMIN', 'QMAX', 'QMIN'}} ...
+    );
+end

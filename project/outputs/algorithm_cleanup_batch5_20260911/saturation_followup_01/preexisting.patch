+  if isempty(Au) && isfield(mpc, 'A')
+    [Au, lbu, ubu] = deal(mpc.A, mpc.l, mpc.u);
+  end
+  if isempty(N) && isfield(mpc, 'N')             %% these two must go together
+    [N, Cw] = deal(mpc.N, mpc.Cw);

+                          0   0    0    0]);
+            c = [-1 -2 -3 -1]';
+            Aineq = [-1  1  1 10;
+               1 -3  1  0];
+            bineq = [20  30]';
+            Aeq   = [0  1  0 -3.5];
+            beq   =  0;
+            xmin    = [ 0;   0;   0; 2];
+            xmax    = [40; Inf; Inf; 3];
+            A = sparse([Aeq; Aineq]);
+            l = [beq; -Inf; -Inf];
+            u = [beq; bineq];
+            vtype = 'CCCI';
+            om = opt_model;
+            om.add_var('x', 4, [], xmin, xmax, vtype);

diff --git a/docs/sphinx/source/matlab-source/matpower/t_node_test.m b/docs/sphinx/source/matlab-source/matpower/t_node_test.m
index 3d3725bd..c4f9a65b 120000
--- a/docs/sphinx/source/matlab-source/matpower/t_node_test.m

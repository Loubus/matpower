+names = {'DEFAULT', 'BPMPD_MEX', 'MIPS', 'sc-MIPS', 'IPOPT', 'linprog/quadprog', 'HiGHS', 'CPLEX', 'MOSEK', 'Gurobi', 'CLP', 'glpk', 'OSQP', 'Knitro'};

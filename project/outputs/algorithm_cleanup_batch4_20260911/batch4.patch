+        if scenario==2
+            taps=r.cpf.branch(s.branch_idx,9,k);
+            check([tag '.tap_grid'],all(arrayfun(@(j) min(abs(s.states_tap{j}-taps(j)))<1e-10,1:s.n)), ...

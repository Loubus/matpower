+    function r = annotate_unified_termination(r)
+        % Success retains the legacy stop-policy semantics. Requested endpoint
+        % completion, electrical-point convergence and control rejection are
+        % separate facts; max_lam is only the largest accepted trace sample.
+        trace = r.cpf;
+        accepted = isfield(trace, 'lam') && ~isempty(trace.lam);
+        last_lambda = [];
+        if accepted
+            last_lambda = trace.lam(end);
+            r.convergence.scope = 'last_accepted_point';
+            r.convergence.lambda = last_lambda;
+        else
+            r.convergence.scope = 'unaccepted_base_point';
+        end
+        cause = 'stopped';
+        names = {trace.events.name};
+        requested = false;
+        nose = any(strcmp(names, 'NOSE'));
+        if ~accepted
+            cause = 'base_failure';
+        elseif ~isempty(trace.failure)
+            cause = 'corrector_failed';
+            if isfield(trace.failure, 'diagnostic')
+                cause = trace.failure.diagnostic.cause;
+            elseif ~isempty(names)
